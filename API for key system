-- version 1 (may not work if not formed right in key system.)

local HttpService = game:GetService("HttpService")

-- Firebase raw JSON URL
local keysURL = "https://key-system-5efa4-default-rtdb.firebaseio.com/keys.json"

-- Executor-safe HTTP request
local http = (syn and syn.request) or (http_request) or (request)
if not http then error("HTTP request not supported") end

-- Function to validate a key
local function validateKey(userKey)
    local response = http({
        Url = keysURL,
        Method = "GET"
    })

    if not response.Success then
        warn("Failed to fetch keys from server")
        return false
    end

    local keysData = HttpService:JSONDecode(response.Body)

    -- Loop through all entries and check 'key' field
    for _, entry in pairs(keysData) do
        if entry.key == userKey then
            return true
        end
    end

    return false
end

