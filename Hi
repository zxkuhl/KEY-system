local t0 = os.clock()

local glitchTimer    = 0

local glitchCooldown = 2.8

local glitchActive   = false

local glitchEnd      = 0

RunService.RenderStepped:Connect(function()

	local t  = os.clock() - t0

	local dt = 1/60

	local scanFrac = (t % 3.4) / 3.4

	scanLine.Position = UDim2.new(0, 0, scanFrac, 0)

	for _, p in ipairs(particles) do

		p.x = p.x + p.vx * dt

		p.y = p.y + p.vy * dt

		if p.x >  1.07 then p.x = -0.07 end

		if p.x < -0.07 then p.x =  1.07 end

		if p.y >  1.07 then p.y = -0.07 end

		if p.y < -0.07 then p.y =  1.07 end

		p.frame.Position = UDim2.new(p.x, 0, p.y, 0)

		local pulse = math.sin(t * 1.9 + p.phase) * 0.2 + 0.55

		p.frame.BackgroundTransparency = 1 - (pulse * (0.28 + p.depth * 0.42))

		local breathe = math.sin(t * 2.3 + p.phase) * 0.14 + 1.0

		local s = p.size * breathe

		p.frame.Size = UDim2.new(0, s, 0, s)

	end

	local lp = math.sin(t * 1.85) * 0.022 + 1.0

	local ls = 72 * lp

	logoFrame.Size     = UDim2.new(0, ls, 0, ls)

	logoFrame.Position = UDim2.new(0, 40 + (72 - ls)/2, 0.5, -(ls/2))

	logoGlow.ImageTransparency = 0.5 + math.sin(t * 1.85) * 0.15

	if math.random() > 0.97 then

		closeBtn.BorderColor3 = C.RED_BRIGHT

	else

		if closeBtn.BackgroundTransparency > 0.6 then

			closeBtn.BorderColor3 = C.RED

		end

	end

	glitchTimer = glitchTimer + dt

	if not glitchActive and glitchTimer >= glitchCooldown then

		glitchActive = true

		glitchEnd    = t + 0.2

		glitchTimer  = 0

	end

	if glitchActive then

		if t < glitchEnd then

			local ox = math.random(-4, 4)

			local oy = math.random(-2, 2)

			titleGlitch.Position          = UDim2.new(0, 126 + ox, 0, 88 + oy)

			titleGlitch.TextTransparency  = math.random() * 0.35 + 0.12

			titleBase.TextColor3 = math.random() > 0.45

				and Color3.fromRGB(190, 60, 190)

				or  C.RED_BRIGHT

		else

			titleGlitch.Position          = titleBase.Position

			titleGlitch.TextTransparency  = 0.55

			titleBase.TextColor3          = C.RED_BRIGHT

			glitchActive                  = false

		end

	end

end)

