-- ─────────────────────────────────────────────

local isSubmitting = false

submitBtn.MouseButton1Click:Connect(function()

	if isSubmitting then return end

	isSubmitting = true

	spawnRipple()

	local userKey = textBox.Text

	if userKey == "" then

		setStatus("— Enter a key first", C.TEXT_ERR, 3)

		isSubmitting = false

		return

	end

	setStatus("Validating key…", C.TEXT_SUB)

	submitBtn.Text = "VALIDATING…"

	print("[XENERATOR] Attempting to contact server...")

	local success, result = pcall(function()

		return game:HttpGet(keysURL)

	end)

	if success and result then

		print("[XENERATOR] ✓ Successfully connected to server")

		print("[XENERATOR] Response length:", #result, "characters")

		

		local decodeOk, keysData = pcall(function()

			return HttpService:JSONDecode(result)

		end)

		

		if decodeOk and keysData then

			print("[XENERATOR] ✓ Successfully decoded JSON")

			print("[XENERATOR] Checking", userKey, "against database...")

			

			local valid = false

			local keyCount = 0

			

			for keyId, entry in pairs(keysData) do

				keyCount = keyCount + 1

				if entry.key == userKey then

					print("[XENERATOR] ✓ KEY MATCH FOUND!")

					valid = true

					break

				end

			end

			

			print("[XENERATOR] Checked against", keyCount, "keys in database")

			if valid then

				setStatus("✓  Access granted", C.TEXT_OK)

				submitBtn.Text             = "GRANTED"

				submitBtn.BackgroundColor3 = Color3.fromRGB(25, 90, 50)

				task.wait(1.1)

				tw(card, { 

					Size = UDim2.new(0, 0, 0, 0),

					Position = UDim2.new(0.5, 0, 0.5, 0),

					BackgroundTransparency = 1 

				}, 0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In)

				tw(bg, { BackgroundTransparency = 1 }, 0.55)

				task.wait(0.6)

				gui:Destroy()

				print("[XENERATOR] ✓ Key validated! Loading main script...")

				-- PUT YOUR MAIN SCRIPT URL HERE:

				-- loadstring(game:HttpGet("YOUR_SCRIPT_URL_HERE"))()

			else

				print("[XENERATOR] ✗ Key not found in database")

				setStatus("✕  Invalid or expired key", C.TEXT_ERR, 4)

				submitBtn.Text             = "VALIDATE KEY"

				submitBtn.BackgroundColor3 = C.RED

			end

		else

			print("[XENERATOR] ✗ Failed to parse JSON response")

			setStatus("✕  Parse error", C.TEXT_ERR, 4)

			submitBtn.Text             = "VALIDATE KEY"

			submitBtn.BackgroundColor3 = C.RED

		end

	else

		print("[XENERATOR] ✗ HTTP request failed")

		print("[XENERATOR] Error:", tostring(result))

		setStatus("✕  Server unreachable", C.TEXT_ERR, 4)

		submitBtn.Text             = "VALIDATE KEY"

		submitBtn.BackgroundColor3 = C.RED

		

		-- Additional debugging

		warn("═══════════════════════════════════")

		warn("[XENERATOR] CONNECTION FAILED")

		warn("Your executor may not support game:HttpGet()")

		warn("OR Firebase is blocking the request")

		warn("Try a different executor or contact support")

		warn("═══════════════════════════════════")

	end

	isSubmitting = false

end)

