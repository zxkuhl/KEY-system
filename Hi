local bracketInstances = {}

local function makeBracket(parent, cx, cy, fx, fy)

	local root = Instance.new("Frame")

	root.Size                   = UDim2.new(0, 0, 0, 0)

	root.BackgroundTransparency = 1

	root.BorderSizePixel        = 0

	local h = Instance.new("Frame")

	h.Size              = UDim2.new(1, 0, 0, 2)

	h.Position          = fy and UDim2.new(0,0,1,-2) or UDim2.new(0,0,0,0)

	h.BackgroundColor3  = C.RED_BRIGHT

	h.BorderSizePixel   = 0

	h.Parent            = root

	local v = Instance.new("Frame")

	v.Size              = UDim2.new(0, 2, 1, 0)

	v.Position          = fx and UDim2.new(1,-2,0,0) or UDim2.new(0,0,0,0)

	v.BackgroundColor3  = C.RED_BRIGHT

	v.BorderSizePixel   = 0

	v.Parent            = root

	local dot = Instance.new("Frame")

	dot.Size            = UDim2.new(0, 4, 0, 4)

	dot.Position        = UDim2.new(fx and 1 or 0, fx and -4 or 0, fy and 1 or 0, fy and -4 or 0)

	dot.BackgroundColor3 = C.RED_BRIGHT

	dot.BorderSizePixel = 0

	dot.Parent          = root

	Instance.new("UICorner", dot).CornerRadius = UDim.new(0.5, 0)

	local m = 14

	root.Position = UDim2.new(cx, cx == 0 and m or (-28-m), cy, cy == 0 and m or (-28-m))

	root.Parent   = parent

	table.insert(bracketInstances, root)

	return root

end

