--  STATUS HELPER

-- ─────────────────────────────────────────────

local function setStatus(msg, color, autoHide)

	statusLabel.Text            = msg

	statusLabel.TextColor3      = color

	statusLabel.TextTransparency = 0

	if autoHide then

		task.delay(autoHide, function()

			tw(statusLabel, { TextTransparency = 1 }, 0.35)

		end)

	end

end

